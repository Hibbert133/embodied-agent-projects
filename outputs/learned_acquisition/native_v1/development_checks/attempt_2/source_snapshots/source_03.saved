"""Independent native integration allocation; not task-gain qualification."""
from datetime import datetime,timezone
from pathlib import Path
import hashlib,subprocess
import numpy as np
from src.analysis import response_qualification_io_v1 as io
from src.analysis.memory_reset_seed_scope_v1 import inventory
from src.analysis import correction_scope_io_v1 as old
ROOT=io.ROOT;BASE=ROOT/'outputs/learned_acquisition/native_v1'
CONFIG=ROOT/'configs/movement_task/learned_acquisition_native_v1.json'
PROTOCOL=ROOT/'docs/protocols/learned_acquisition_native_v1_zh.md'
SEEDS=ROOT/'docs/protocols/learned_acquisition_native_seeds_v1.json'
ASSETS=ROOT/'assets/learned_acquisition_native_v1'
PROGRAMS=('LEGACY_REFERENCE','DYNAMIC_FORCED_REFERENCE','LEARNED_JOINT_BANK0')
KEYS=('cohort','group','task','seed','context','planned_boundary','program')
IDENTITY=old.IDENTITY
REFERENCES={16:('CONTINUE',.5),32:('VALIDATE8',.125),64:('MOVE_MEASURE',.5)}


def population(cohort='NATIVE'):
    io.require(cohort=='NATIVE','native integration only, no TRAIN/CAL/QUAL allocation')
    return [dict(cohort='NATIVE',group=g,task=t,seed=90000+3*g+i,context=c,planned_boundary=(16,32,64)[g],program=p)
        for g in range(3) for i,t in enumerate(old.TASKS) for c in ('UNCHANGED','CHANGED') for p in PROGRAMS]


def validate_spec(spec):io.require(type(spec) is dict and set(spec)==set(KEYS) and spec in population(),'registered native spec')
def case_key(spec):return tuple(spec[k] for k in KEYS)
def unit_key(spec):return tuple(spec[k] for k in ('cohort','group','task','context'))
def reference(spec):return REFERENCES[spec['planned_boundary']]
def initial_fault():return old.initial_fault()


def destination(spec):
    if spec['context']=='UNCHANGED':return initial_fault()
    r=np.random.default_rng(np.random.SeedSequence([202610271,spec['group']]))
    return dict(matrix_xy=[[float(r.uniform(.75,1.25)),float(r.uniform(-.2,.2))],
        [float(r.uniform(-.2,.2)),float(r.uniform(.75,1.25))]],bias_xy=r.uniform(-.2,.2,2).tolist(),deadzone_xy=[0.,0.])


def noise(spec):
    result=np.random.default_rng(np.random.SeedSequence([spec['seed'],202610272])).normal(0,.05,(500,3)).astype('<f4')
    result.flags.writeable=False;return result


def limits(cohort='NATIVE'):
    io.require(cohort=='NATIVE','no other population')
    return dict(executions=54,control_steps=27000,controlled_resets=54,all_resets=2754,physical_frames=1512000,
        actual_fixed_policy_queries_max=27000,audit_fixed_policy_queries_max=27000,live_model_decision_calls_max=36,
        new_model_fits=0,online_LLM_API_calls=0)


def source_bindings(c):
    base=ROOT/c['source_learning_run'];train=ROOT/c['source_A1_run']/'train'
    paths=[base/n for n in ('manifest.json','bank.json','model_audit.json','replay_audit.json','results.json')]
    paths.extend((train/'cases.jsonl.gz',train/'examples.jsonl.gz',train/'audit.json',train/'summary.json',
        train.parent/'results/statistics.json',ROOT/'outputs/correction_scope/common_state_audit_v1/train.json'))
    bank=io.read(base/'bank.json');selected=bank['models']['0']['JOINT_SPO']
    paths.extend(base/'models'/selected[k]['file'] for k in ('receiver','precritic'))
    bound={}
    for p in paths:
        name=p.relative_to(ROOT).as_posix();blob=subprocess.check_output(['git','show',c['source_result_commit']+':'+name],cwd=ROOT)
        io.require(hashlib.sha256(blob).hexdigest()==io.sha(p),'source committed bytes '+name);bound[name]=io.sha(p)
    audit=io.read(train/'audit.json');io.require(audit['integrity']=='PASSED','audited source TRAIN')
    for name,digest in audit['collection_sha256'].items():
        p=train/name;io.require(io.sha(p)==digest,'source raw checksum '+name);bound[p.relative_to(ROOT).as_posix()]=digest
    return bound


def prepare():
    v=io.read(BASE/'freeze_validation/complete.json');io.require(v['integrity']=='PASSED','committed native freeze')
    io.require(not io.git('status','--porcelain','--untracked-files=no') and not list(BASE.glob('run_*/manifest.json')),'one native allocation, clean committed sources')
    for name,digest in v['source_sha256'].items():io.require(io.sha(ROOT/name)==digest,'immutable native source '+name)
    c=io.read(CONFIG);bindings=source_bindings(c);head=io.git('rev-parse','HEAD')
    owned={CONFIG.relative_to(ROOT).as_posix(),PROTOCOL.relative_to(ROOT).as_posix(),SEEDS.relative_to(ROOT).as_posix(),
        'docs/research/learned_acquisition_native_decision_v1_zh.md'}
    scope=inventory(ROOT,owned,90000,90999)
    out=BASE/('run_'+datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')+'_'+head[:12]);out.mkdir(exist_ok=False)
    io.write(out/'seed_scope.json',scope)
    m=dict(protocol=c['protocol'],classification=c['classification'],source_git_commit=head,config=c,population=population(),limits=limits(),
        source_sha256=v['source_sha256'],input_sha256=bindings,seed_scope_sha256=io.sha(out/'seed_scope.json'),
        bundle_id=io.read(ASSETS/'bundle.json')['bundle_id'],new_model_fits=0,online_LLM_API_calls=0,task_gain_qualification=False)
    m['manifest_id']=io.digest(m);io.write(out/'manifest.json',m);return out/'manifest.json'


def checked(path):
    path=Path(path).resolve();m=io.read(path);copy=dict(m);mid=copy.pop('manifest_id')
    io.require(path.parent.parent==BASE.resolve() and mid==io.digest(copy) and m['config']==io.read(CONFIG),'owned frozen native manifest')
    io.require(m['population']==population() and m['limits']==limits(),'immutable native allocation and complete costs')
    for n,h in {**m['source_sha256'],**m['input_sha256']}.items():io.require(io.sha(ROOT/n)==h,'immutable source '+n)
    return m
